# =============================================================================
# ShivWebsIndia.com — Production Environment Configuration (.env.example)
# Copy this file to .env outside your public_html web root on Hostinger/cPanel
# Never commit real database credentials or SMTP passwords to version control!
# =============================================================================

APP_NAME="ShivWebsIndia"
APP_ENV="production"
APP_DEBUG="false"
APP_URL="https://www.shivwebsindia.com"
APP_TIMEZONE="Asia/Kolkata"

# MySQL Database (InnoDB / utf8mb4) - Configure in Hostinger hPanel -> Databases
DB_CONNECTION="mysql"
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_DATABASE="u123456789_shivwebs"
DB_USERNAME="u123456789_admin"
DB_PASSWORD="CHANGE_ME_STRONG_DATABASE_PASSWORD"

# Session & CSRF Security
SESSION_COOKIE_NAME="SHIVWEBS_SESSID"
SESSION_LIFETIME_MINUTES="120"
SESSION_SECURE_COOKIE="true"
LOGIN_MAX_ATTEMPTS="5"
LOGIN_LOCKOUT_SECONDS="900"

# Lead Notification & Password Reset Email (Hostinger SMTP)
MAIL_MAILER="smtp"
MAIL_HOST="smtp.hostinger.com"
MAIL_PORT="465"
MAIL_USERNAME="info@shivwebsindia.com"
MAIL_PASSWORD="CHANGE_ME_SMTP_PASSWORD"
MAIL_ENCRYPTION="ssl"
MAIL_FROM_ADDRESS="info@shivwebsindia.com"
MAIL_FROM_NAME="ShivWebsIndia Website"
LEAD_NOTIFICATION_RECIPIENT="shivwebsindia@gmail.com"

# Default Brand Configuration
BRAND_PRIMARY_NAVY="#0A2540"
BRAND_PRIMARY_ORANGE="#FF6A00"
BRAND_ACCENT_RED="#8B1E1E"
BRAND_LIGHT_BG="#F5F7FA"
CONTACT_PHONE="+91-8667666429"
CONTACT_WHATSAPP="918667666429"
LOCATION_FOCUS="Vaishali, Sector 3, Ghaziabad & Delhi NCR"
